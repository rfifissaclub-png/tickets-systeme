# Docker Compose configuration for TMS.
#
# Copy this file to `.env` in this directory and adjust values as needed.
# Docker Compose automatically loads `.env` from the project directory (where
# you run `docker compose`), so no extra flags are required.
#
# All variables default to localhost ports — uncomment and edit to override.

# Host name browsers should use when reaching the stack from *another* device
# (e.g. phone, tablet, a second workstation on the same LAN).
#
#   - Leave unset / "localhost" to access only from this machine.
#   - Set to your machine's LAN IP (e.g. 192.168.1.42) to access from other
#     devices on the same network.
# APP_HOST=localhost

# Host ports exposed by each service. Change if a port is already in use on
# your machine.
# NGINX_PORT=8080
# FRONTEND_PORT=8081
# REVERB_PORT=8085
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
# CLAMAV_PORT=3310

# WebSocket scheme used by the frontend (http or https).
# REVERB_SCHEME=http

# PHP version for the backend image (must be available on the registry).
# PHP_VERSION=8.4

# User/group ID for files inside the PHP containers. Set to your local
# UID/GID if the bind-mounted source files are owned by a different user,
# e.g.:
#   TMS_UID=$(id -u)  TMS_GID=$(id -g)
# This avoids permission conflicts when your host's UID 1000 belongs to a
# real user account (common on macOS, Fedora, etc.).
# TMS_UID=1000
# TMS_GID=1000

# --- Service credentials (change for non-local use) ---

# PostgreSQL superuser password (set in the official postgres image).
# POSTGRES_PASSWORD=secret
# Database name to create on first boot.
# POSTGRES_DB=tms

# MinIO object-storage root credentials (dev only).
# MINIO_ROOT_USER=tms-minio
# MINIO_ROOT_PASSWORD=tms-minio-secret
