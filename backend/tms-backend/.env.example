APP_NAME=TMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tms
DB_USERNAME=tms
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

REVERB_APP_ID=432706
REVERB_APP_KEY=192812dbb36576c8ee12
REVERB_APP_SECRET=cc5336edbdcc32ccfcb3df3ddec0ef59
# Server-to-server: the PHP app publishing events reaches Reverb over the
# internal Docker network, at the container's default bind port (8080).
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Browser-to-server: the frontend (Phase 6) connects from outside Docker, so
# it needs the host-mapped port (see infra/docker-compose.yml) instead.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT=8085
VITE_REVERB_SCHEME=http

CACHE_STORE=redis
CACHE_PREFIX=tms_cache

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@tms.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=tms-minio
AWS_SECRET_ACCESS_KEY=tms-minio-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=tms-storage
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://minio:9000

VITE_APP_NAME="${APP_NAME}"

L5_SWAGGER_CONST_HOST=http://localhost:8080/api/v1
