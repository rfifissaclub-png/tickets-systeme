<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            DB_CONNECTION/DB_DATABASE are pinned here so tests can never
            accidentally run against sqlite (RLS/UUID features require real
            Postgres) or the dev database. Host/port/credentials are
            deliberately NOT pinned: they differ between local Docker Compose
            (host "postgres") and CI (host "127.0.0.1", a GitHub Actions
            service container) and must come from the real environment.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="tms_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!--
            Pinned off: the real .env points ATTACHMENTS_AV_HOST at "clamav",
            a Docker-internal hostname that doesn't resolve outside the
            compose network. Individual tests that need scanning behavior
            bind a fake VirusScanner directly (see
            TicketAttachmentAntivirusTest) rather than depending on a real
            clamd being reachable from wherever tests happen to run.
        -->
        <env name="ATTACHMENTS_AV_ENABLED" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
